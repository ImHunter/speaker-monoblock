root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
# два пробела в конце строки = перенос строки
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[archive/**]
# исходник хранится как есть
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
